FROM ghcr.io/cross-rs/armv7-unknown-linux-musleabihf:main

ENV SX1301_VERSION=v5.0.1r4
ENV SX1302_VERSION=V2.1.0r9
ENV SX2G4_VERSION=V1.1.0

ENV HAL_ARCH=arm
ENV MUSL_PREFIX=arm-unknown-linux-musleabihf

RUN apt-get update && \
    apt-get --assume-yes install \
    protobuf-compiler \
    libprotobuf-dev \
    git

RUN mkdir /hal && \
  mkdir -p /x-tools/$MUSL_PREFIX/$MUSL_PREFIX/sysroot/include

# Needed for RAK shields, works with other shields too
# sed -i 's/define SPI_SPEED.*/define SPI_SPEED 2000000/g' /hal/lora_gateway/libloragw/src/loragw_spi.native.c

RUN echo "Building sx1301 HAL" && \
    cd /hal && \
    git clone https://github.com/brocaar/lora_gateway.git -b $SX1301_VERSION && \
    cd /hal/lora_gateway && \
    ARCH=$ARCH CROSS_COMPILE=$MUSL_PREFIX- make && \
    ln -s /hal/lora_gateway/libloragw/inc /x-tools/$MUSL_PREFIX/$MUSL_PREFIX/sysroot/include/libloragw-sx1301 && \
    ln -s /hal/lora_gateway/libloragw/libloragw.a /x-tools/$MUSL_PREFIX/$MUSL_PREFIX/sysroot/lib/libloragw-sx1301.a

RUN echo "Building sx1302 HAL" && \
    cd /hal && \
    git clone https://github.com/brocaar/sx1302_hal.git -b $SX1302_VERSION && \
    cd /hal/sx1302_hal && \
    ARCH=$ARCH CROSS_COMPILE=$MUSL_PREFIX- make libloragw && \
    ln -s /hal/sx1302_hal/libloragw/inc /x-tools/$MUSL_PREFIX/$MUSL_PREFIX/sysroot/include/libloragw-sx1302 && \
    ln -s /hal/sx1302_hal/libloragw/libloragw.a /x-tools/$MUSL_PREFIX/$MUSL_PREFIX/sysroot/lib/libloragw-sx1302.a && \
    cp /hal/sx1302_hal/libtools/inc/* /x-tools/$MUSL_PREFIX/$MUSL_PREFIX/sysroot/include && \
    cp /hal/sx1302_hal/libtools/*.a /x-tools/$MUSL_PREFIX/$MUSL_PREFIX/sysroot/lib

RUN echo "Building 2g4 HAL" && \
    cd /hal && \
    git clone https://github.com/Lora-net/gateway_2g4_hal.git -b $SX2G4_VERSION && \
    cd /hal/gateway_2g4_hal && \
    ARCH=$ARCH CROSS_COMPILE=$MUSL_PREFIX- make libloragw && \
    ln -s /hal/gateway_2g4_hal/libloragw/inc /x-tools/$MUSL_PREFIX/$MUSL_PREFIX/sysroot/include/libloragw-2g4 && \
    ln -s /hal/gateway_2g4_hal/libloragw/libloragw.a /x-tools/$MUSL_PREFIX/$MUSL_PREFIX/sysroot/lib/libloragw-2g4.a
